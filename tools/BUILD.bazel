load("@rules_kotlin//kotlin:core.bzl", "define_kt_toolchain", "kt_compiler_plugin", "kt_ksp_plugin")
load("@rules_python//python:py_binary.bzl", "py_binary")

exports_files(["AndroidManifest.xml"])

define_kt_toolchain(
    name = "kotlin_toolchain",
    jvm_target = "17",
)

platform(
    name = "android_arm64",
    constraint_values = [
        "@platforms//cpu:arm64",
        "@platforms//os:android",
    ],
)

platform(
    name = "android_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:android",
    ],
)

kt_compiler_plugin(
    name = "compose_compiler",
    id = "androidx.compose.compiler.plugins.kotlin",
    target_embedded_compiler = True,
    visibility = ["//visibility:public"],
    deps = ["@maven//:org_jetbrains_kotlin_kotlin_compose_compiler_plugin_embeddable"],
)

kt_compiler_plugin(
    name = "metro_compiler",
    id = "dev.zacsweers.metro.compiler",
    target_embedded_compiler = True,
    visibility = ["//visibility:public"],
    deps = ["@maven//:dev_zacsweers_metro_compiler"],
)

kt_ksp_plugin(
    name = "ktorfit_ksp",
    processor_class = "de.jensklingenberg.ktorfit.KtorfitProcessorProvider",
    visibility = ["//visibility:public"],
    deps = ["@maven//:de_jensklingenberg_ktorfit_ktorfit_ksp"],
)

py_binary(
    name = "compose_resources_gen",
    srcs = ["compose_resources/generate.py"],
    main = "compose_resources/generate.py",
    visibility = ["//visibility:public"],
)

kt_compiler_plugin(
    name = "serialization_compiler",
    id = "org.jetbrains.kotlinx.serialization",
    target_embedded_compiler = True,
    visibility = ["//visibility:public"],
    deps = ["@maven//:org_jetbrains_kotlin_kotlin_serialization_compiler_plugin_embeddable"],
)
